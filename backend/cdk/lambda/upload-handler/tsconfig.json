{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node"],
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./Dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "dist"]
}
